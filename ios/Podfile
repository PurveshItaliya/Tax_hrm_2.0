# Uncomment this line to define a global platform for your project
# platform :ios, '15.0'
platform :ios, '15.5'
# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_PHOTOS=1'
      ]
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end

  # Auto-patch google_mlkit_commons for iOS camera orientation support
  mlk_file = File.expand_path(".symlinks/plugins/google_mlkit_commons/ios/Classes/MLKVisionImage+FlutterPlugin.swift", __dir__)
  if File.exist?(mlk_file)
    real_file = File.realpath(mlk_file)
    content = File.read(real_file)
    unless content.include?("pixelBufferToVisionImage(_ pixelBufferRef: CVPixelBuffer, rotation: Int")
      puts "[Podfile] Patching google_mlkit_commons for physical camera frame rotation on iOS..."
      unless content.include?("static let ciContext")
        content.sub!("extension VisionImage {", "extension VisionImage {\n  private static let ciContext = CIContext(options: [CIContextOption.useSoftwareRenderer: false])\n")
      end

      old_func_pattern = /private static func pixelBufferToVisionImage\(_ pixelBufferRef: CVPixelBuffer.*?return VisionImage\(image: uiImage\)\s*\}/m
      new_func = <<-SWIFT
private static func pixelBufferToVisionImage(_ pixelBufferRef: CVPixelBuffer, rotation: Int = 0) -> VisionImage? {
    let ciImage = CIImage(cvPixelBuffer: pixelBufferRef)
    let orientedCi: CIImage
    switch rotation {
    case 90:
      orientedCi = ciImage.oriented(.right)
    case 180:
      orientedCi = ciImage.oriented(.down)
    case 270:
      orientedCi = ciImage.oriented(.left)
    default:
      orientedCi = ciImage
    }

    guard let cgImage = ciContext.createCGImage(
      orientedCi,
      from: orientedCi.extent
    ) else {
      return nil
    }
    let uiImage = UIImage(cgImage: cgImage)
    return VisionImage(image: uiImage)
  }
SWIFT
      content.sub!(old_func_pattern, new_func.strip) if content.match?(old_func_pattern)

      old_call_pattern = /if let visionImage = pixelBufferToVisionImage\(pxBuffer.*?return visionImage\s*\}/m
      new_call = <<-SWIFT
let rotationVal = (metadata["rotation"] as? NSNumber)?.intValue ?? 0
    if let visionImage = pixelBufferToVisionImage(pxBuffer, rotation: rotationVal) {
      return visionImage
    }
SWIFT
      content.sub!(old_call_pattern, new_call.strip) if content.match?(old_call_pattern)

      File.write(real_file, content)
    end
  end
end
