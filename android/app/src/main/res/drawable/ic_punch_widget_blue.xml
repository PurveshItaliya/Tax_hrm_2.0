<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Rich Dark Primary Blue Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="135"
                android:startColor="#104EC8"
                android:centerColor="#0F49BB"
                android:endColor="#0A368A"
                android:type="linear" />
        </shape>
    </item>

    <!-- 2. Subtle Glass Specular Edge Highlight -->
    <item
        android:bottom="14dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp"
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="8dp" />
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>

    <!-- 3. Specular Rim Stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="1.5dp"
                android:color="#59FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>

